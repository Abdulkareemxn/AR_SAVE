<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <group
        android:pivotX="60"
        android:pivotY="55"
        android:scaleX="0.72"
        android:scaleY="0.72">

        <!-- Subtle Glow Halo -->
        <path
            android:pathData="M60,10 A50,50 0 1,0 60,110 A50,50 0 1,0 60,10 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:centerX="60"
                    android:centerY="55"
                    android:gradientRadius="48"
                    android:type="radial">
                    <item android:color="#4000E5FF" android:offset="0.0" />
                    <item android:color="#00000000" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Left Wing of Geometric 'A' (Cyan to Blue) -->
        <path
            android:pathData="M60,18 L34,88 L49,88 L56,69 L64,69 L60,18 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="34"
                    android:startY="88"
                    android:endX="60"
                    android:endY="18"
                    android:type="linear">
                    <item android:color="#0072FF" android:offset="0.0" />
                    <item android:color="#00C6FF" android:offset="0.5" />
                    <item android:color="#38E1FF" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Right Wing of Geometric 'A' (Cobalt to Deep Blue) -->
        <path
            android:pathData="M60,18 L56,69 L67,69 L74,88 L86,88 L60,18 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="60"
                    android:startY="18"
                    android:endX="86"
                    android:endY="88"
                    android:type="linear">
                    <item android:color="#00C6FF" android:offset="0.0" />
                    <item android:color="#0072FF" android:offset="0.5" />
                    <item android:color="#0044CC" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Dynamic Modern Forward Cross-Slash -->
        <path
            android:pathData="M43,62 L77,62 L72,74 L39,74 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:startX="39"
                    android:startY="68"
                    android:endX="77"
                    android:endY="68"
                    android:type="linear">
                    <item android:color="#00E5FF" android:offset="0.0" />
                    <item android:color="#0066FF" android:offset="1.0" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Inner Triangular Cutout -->
        <path
            android:pathData="M60,36 L52,56 L68,56 Z"
            android:fillColor="#0B0F17" />
    </group>
</vector>